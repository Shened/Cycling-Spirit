// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String       @id @default(cuid())
  name                 String
  email                String       @unique
  password             String?
  avatar               String?
  weightKg             Float?
  ftpWatts             Int?
  stravaId             String?      @unique
  stravaAccessToken    String?
  stravaRefreshToken   String?
  stravaTokenExpiresAt DateTime?
  dashboardWidgets     String[]     @default(["distance", "duration", "elevation", "calories", "activities", "avgWatts"])
  defaultActivityType  ActivityType @default(ride)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  isPublic             Boolean      @default(true)
  lastSyncAt           DateTime?
  hrZones              Json? // [{zone:1, min:100, max:130}, ...]
  ftpZones             Json? // para o futuro, se quiseres personalizar potência também
  goals                Goal[]

  // Relations
  activities          Activity[]
  ownedTeams          Team[]                @relation("TeamOwner")
  teamMemberships     TeamMember[]
  sentInvitations     TeamInvitation[]      @relation("InvitedBy")
  plannedActivities   PlannedActivity[]
  competitionEntries  CompetitionEntry[]
  createdCompetitions Competition[]         @relation("CompetitionCreator")
  competitionInvites  CompetitionInvite[]
  accounts            Account[]
  sessions            Session[]
  sentFriendships     Friendship[]          @relation("FriendshipSender")
  receivedFriendships Friendship[]          @relation("FriendshipReceiver")
  organisedTours      Tour[]                @relation("TourOrganiser")
  tourParticipations  TourParticipant[]
  tourStageResults    TourStageResult[]
  tourSpecialResults  TourSpecialResult[]
  segmentEfforts      StravaSegmentEffort[]
  personalRecord      StravaPersonalRecord?
  competitions        Competition[]
  teamJoinRequests    TeamJoinRequest[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Activity {
  id              String       @id @default(cuid())
  userId          String
  title           String
  type            ActivityType @default(ride)
  distanceKm      Float
  durationSeconds Int
  elevationM      Int?
  avgWatts        Int?
  avgHeartRate    Float?
  calories        Int?
  avgSpeedKmh     Float?
  polyline        String?
  startedAt       DateTime
  stravaId        String?      @unique
  isManual        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("activities")
}

enum ActivityType {
  ride
  mountain_bike
  gravel_ride
  e_bike
  virtual_ride
  run
  trail_run
  walk
  hike
  swim
}

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner             User              @relation("TeamOwner", fields: [ownerId], references: [id])
  members           TeamMember[]
  invitations       TeamInvitation[]
  plannedActivities PlannedActivity[]
  competitions      Competition[]
  tours             Tour[]
  teamJoinRequests  TeamJoinRequest[]

  @@map("teams")
}

model TeamMember {
  teamId   String
  userId   String
  role     TeamRole @default(member)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

enum TeamRole {
  owner
  admin
  member
}

model TeamInvitation {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  token       String    @unique
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("team_invitations")
}

model PlannedActivity {
  id                  String       @id @default(cuid())
  userId              String
  teamId              String?
  title               String
  description         String?
  type                ActivityType @default(ride)
  targetDistanceKm    Float?
  targetDurationMin   Int?
  targetWatts         Int?
  scheduledFor        DateTime
  isTeamShared        Boolean      @default(false)
  completed           Boolean      @default(false)
  completedActivityId String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledFor])
  @@index([teamId, scheduledFor])
  @@map("planned_activities")
}

model Competition {
  id                    String            @id @default(cuid())
  teamId                String?
  title                 String
  description           String?
  metric                CompetitionMetric
  eligibleActivityTypes String[]          @default(["ride"])
  startDate             DateTime
  endDate               DateTime
  status                CompetitionStatus @default(approved)
  createdById           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  team      Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User                @relation("CompetitionCreator", fields: [createdById], references: [id])
  entries   CompetitionEntry[]
  invites   CompetitionInvite[]
  user      User?               @relation(fields: [userId], references: [id])
  userId    String?

  @@map("competitions")
}

model CompetitionInvite {
  id            String                  @id @default(cuid())
  competitionId String
  userId        String
  status        CompetitionInviteStatus @default(pending)
  createdAt     DateTime                @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@map("competition_invites")
}

enum CompetitionStatus {
  pending
  approved
  rejected
}

enum CompetitionInviteStatus {
  pending
  accepted
  declined
}

enum CompetitionMetric {
  distance_km
  elevation_m
  avg_speed
  duration_hours
  activities_count
}

model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  value         Float    @default(0)
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@map("competition_entries")
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friendships")
}

enum FriendshipStatus {
  pending
  accepted
  declined
}

// ─── TOUR ────────────────────────────────────────────────────────────────────

model Tour {
  id           String       @id @default(cuid())
  name         String
  description  String?
  organiserId  String
  teamId       String?
  type         TourType     @default(multistage)
  status       TourStatus   @default(upcoming)
  activityType ActivityType @default(ride)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  organiser    User              @relation("TourOrganiser", fields: [organiserId], references: [id])
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  stages       TourStage[]
  participants TourParticipant[]
  tourTeams    TourTeam[]

  @@map("tours")
}

enum TourType {
  single
  multistage
}

enum TourStatus {
  upcoming
  active
  finished
}

model TourTeam {
  id     String @id @default(cuid())
  tourId String
  name   String
  color  String @default("#2B8FBF")

  tour         Tour              @relation(fields: [tourId], references: [id], onDelete: Cascade)
  participants TourParticipant[]

  @@map("tour_teams")
}

model TourParticipant {
  id         String                @id @default(cuid())
  tourId     String
  userId     String
  tourTeamId String?
  status     TourParticipantStatus @default(pending)
  createdAt  DateTime              @default(now())

  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourTeam TourTeam? @relation(fields: [tourTeamId], references: [id], onDelete: SetNull)

  @@unique([tourId, userId])
  @@map("tour_participants")
}

enum TourParticipantStatus {
  pending
  accepted
  declined
}

model TourStage {
  id          String        @id @default(cuid())
  tourId      String
  number      Int
  name        String
  date        DateTime
  distanceKm  Float?
  elevationM  Int?
  type        TourStageType @default(regular)
  description String?
  polyline    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tour          Tour               @relation(fields: [tourId], references: [id], onDelete: Cascade)
  results       TourStageResult[]
  specialPoints TourSpecialPoint[]

  @@unique([tourId, number])
  @@map("tour_stages")
}

enum TourStageType {
  regular
  sprint
  mountain
  tt
}

model TourStageResult {
  id               String   @id @default(cuid())
  stageId          String
  userId           String
  position         Int?
  timeSeconds      Int?
  bonusSeconds     Int      @default(0)
  points           Int      @default(0)
  stravaActivityId String?
  dnf              Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stage TourStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stageId, userId])
  @@map("tour_stage_results")
}

model TourSpecialPoint {
  id              String          @id @default(cuid())
  stageId         String
  name            String
  type            TourSpecialType
  km              Float?
  stravaSegmentId String?
  createdAt       DateTime        @default(now())

  stage   TourStage           @relation(fields: [stageId], references: [id], onDelete: Cascade)
  results TourSpecialResult[]

  @@map("tour_special_points")
}

enum TourSpecialType {
  sprint
  mountain
}

model TourSpecialResult {
  id             String   @id @default(cuid())
  specialPointId String
  userId         String
  position       Int
  points         Int      @default(0)
  createdAt      DateTime @default(now())

  specialPoint TourSpecialPoint @relation(fields: [specialPointId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([specialPointId, userId])
  @@map("tour_special_results")
}

model StravaSegmentEffort {
  id             String   @id @default(cuid())
  userId         String
  segmentId      String
  segmentName    String
  distanceM      Float
  elapsedSeconds Int
  startDate      DateTime
  komRank        Int?
  prRank         Int?
  avgGrade       Float?
  city           String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, segmentId])
  @@map("strava_segment_efforts")
}

model StravaPersonalRecord {
  id                  String   @id @default(cuid())
  userId              String   @unique
  longestDistanceKm   Float    @default(0)
  longestActivityId   String?
  highestElevationM   Int      @default(0)
  highestElevationId  String?
  fastestSpeedKmh     Float    @default(0)
  fastestSpeedId      String?
  highestWatts        Int      @default(0)
  highestWattsId      String?
  longestDurationSecs Int      @default(0)
  longestDurationId   String?
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("strava_personal_records")
}

model TeamJoinRequest {
  id        String                @id @default(cuid())
  teamId    String
  userId    String
  message   String?
  status    TeamJoinRequestStatus @default(pending)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_join_requests")
}

enum TeamJoinRequestStatus {
  pending
  accepted
  declined
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  metric        String
  period        String
  target        Float
  year          Int
  month         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  activityGroup String   @default("all") // "cycling" | "running" | "swimming" | "walking" | null (todos)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, period, year, month, activityGroup])
  @@map("goals")
}
